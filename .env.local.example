# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Dashboard → Project Settings → API Keys).
# Chaves NOVAS do Supabase: publishable (sb_publishable_...) no lugar da
# antiga anon key — os NOMES das variáveis ficaram os históricos.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-publishable-key-aqui

# Secret key (sb_secret_...) — só para rodar `npm run seed` no seu computador.
# NUNCA commitar, NUNCA colocar na Vercel.
SUPABASE_SERVICE_ROLE_KEY=coloque-a-secret-key-aqui

# Conexão direta com o banco, só para `npm run migrar` no seu computador.
# Supabase → Connect → Session pooler → URI (com a senha do banco).
# NUNCA commitar, NUNCA colocar na Vercel.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
